{
  "name": "lynx",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first personal AI assistant",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel dev",
    "dev:server": "pnpm --filter @lynx/server dev",
    "dev:desktop": "pnpm --filter @lynx/desktop dev",
    "build": "pnpm --filter @lynx/shared build && pnpm --filter @lynx/server build && pnpm --filter @lynx/desktop build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "clean": "pnpm -r exec rm -rf dist node_modules"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
